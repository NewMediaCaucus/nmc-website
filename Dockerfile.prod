# Pin exact PHP patch version for production
FROM php:8.3.36-apache

# Set timezone
ENV TZ=Europe/Berlin

# Install system packages + PHP extension build dependencies
RUN apt-get update && apt-get install -y \
  ca-certificates \
  git \
  git-lfs \
  cron \
  libicu-dev \
  libzip-dev \
  libpng-dev \
  libjpeg62-turbo-dev \
  libfreetype6-dev \
  libonig-dev \
  libxml2-dev && \
  docker-php-ext-configure gd --with-freetype --with-jpeg && \
  docker-php-ext-install -j"$(nproc)" intl mbstring gd zip dom && \
  apt-get clean && rm -rf /var/lib/apt/lists/*

# Initialize Git LFS
RUN git lfs install

# Enable required Apache modules and explicitly disable distro default SSL site
RUN a2enmod ssl headers rewrite && \
  a2dissite default-ssl || true && \
  rm -f /etc/apache2/sites-enabled/default-ssl.conf /etc/apache2/sites-available/default-ssl.conf

# Copy virtual host configuration from current path onto existing 000-default.conf
COPY default.prod.conf /etc/apache2/sites-available/000-default.conf

# Copy custom PHP config (volume mount in deploy overrides at runtime)
COPY custom-php.prod.ini /usr/local/etc/php/conf.d/custom-php.ini

# Remove default content (existing index.html)
RUN rm -f /var/www/html/*

# Change web server's user id to match local user, replace with your local user id
COPY entrypoint.sh /usr/local/bin/
ENTRYPOINT ["entrypoint.sh"]

# Tell container to listen to port 80 at runtime
EXPOSE 80 443

# Start Apache web server
CMD ["apache2-foreground"]